<Application
    x:Class="BackupAndroid.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 default styles and brushes must load before custom resources.
                     Missing this dictionary causes TabViewButtonBackground lookup failures
                     when NavigationView is initialized. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppCanvas" Color="#DB151A21"/>
                    <SolidColorBrush x:Key="Surface" Color="#F0232A32"/>
                    <SolidColorBrush x:Key="SurfaceStroke" Color="#4B5865"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppCanvas" Color="#EAF5F7FA"/>
                    <SolidColorBrush x:Key="Surface" Color="#F9FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceStroke" Color="#DCE3E9"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="SurfaceCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource Surface}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStroke}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="22"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
