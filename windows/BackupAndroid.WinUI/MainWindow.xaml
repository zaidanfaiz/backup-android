<Window
    x:Class="BackupAndroid.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Android Backup">
    <Grid Background="{ThemeResource AppCanvas}" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compact native Fluent command header. Every status is connected to real UI state. -->
        <Grid Grid.Row="0" Padding="28,15,28,15" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="46" Height="46" Background="{ThemeResource AccentWash}"
                    CornerRadius="13" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/icon.svg" Width="34" Height="34"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="Android Backup" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="BACKUP  /  RESTORE  /  SECURITY"
                           FontSize="10" CharacterSpacing="1" Foreground="{ThemeResource MutedText}"/>
            </StackPanel>
            <Border Grid.Column="2" Background="{ThemeResource QuietSurface}"
                    BorderBrush="{ThemeResource SurfaceStroke}" BorderThickness="1"
                    CornerRadius="12" Padding="13,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Sync" Foreground="{ThemeResource MutedText}"/>
                    <TextBlock x:Name="HeaderStatusText" Text="Waiting for Android"
                               Foreground="{ThemeResource MutedText}" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <NavigationView Grid.Row="1" x:Name="Shell" PaneDisplayMode="Left" MinHeight="0" VerticalAlignment="Stretch" Background="Transparent"
                        OpenPaneLength="230" CompactPaneLength="52"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Applications" Tag="apps">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Photos &amp; files" Tag="storage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Restore app data" Tag="restore">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Refresh"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ransomware scan" Tag="security">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Find"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Setup &amp; drivers" Tag="setup">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid Padding="24,12,24,18" MinHeight="0">
                <ScrollViewer x:Name="OverviewPage" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Visible"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="1080" Spacing="12" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6" Margin="0,2,0,12">
                            <TextBlock Text="Overview" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="A single place for rooted app backups, recovery, and storage health."
                                       Style="{StaticResource SectionDescription}"/>
                        </StackPanel>
                        <!-- Primary actions use a real navigation destination, never decorative buttons. -->
                        <Border Background="{ThemeResource HeroSurface}"
                                BorderBrush="{ThemeResource SurfaceStroke}" BorderThickness="1"
                                CornerRadius="20" Padding="24" Margin="0,0,0,6">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="9">
                                    <TextBlock Text="YOUR ANDROID WORKSPACE" FontSize="11" FontWeight="SemiBold"
                                               CharacterSpacing="1.4" Foreground="{ThemeResource MutedText}"/>
                                    <TextBlock Text="Your apps. Your data. Backed up."
                                               FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"
                                               MaxWidth="500"/>
                                    <TextBlock Text="Choose your apps, save private data with temporary root, and restore only after checking compatibility."
                                               Style="{StaticResource SectionDescription}" MaxWidth="540"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                                    <Button Content="Choose apps" Click="OpenApplications_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch" MinWidth="132"/>
                                    <Button Content="Restore data" Click="OpenRestore_Click"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Four actual live status values. No simulated storage or backup metrics. -->
                        <Grid ColumnSpacing="12" RowSpacing="12" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SurfaceCard}" Margin="0">
                                <StackPanel Spacing="9">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="CellPhone" Foreground="{ThemeResource MutedText}"/>
                                        <TextBlock Text="DEVICE" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource MutedText}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="OverviewDeviceValue" Text="Not connected"
                                               FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="ADB connection" Style="{StaticResource SectionDescription}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="0">
                                <StackPanel Spacing="9">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Shield" Foreground="{ThemeResource MutedText}"/>
                                        <TextBlock Text="ROOT STATUS" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource MutedText}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="OverviewRootValue" Text="Not verified"
                                               FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Required for private app data" Style="{StaticResource SectionDescription}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SurfaceCard}" Margin="0">
                                <StackPanel Spacing="9">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="AllApps" Foreground="{ThemeResource MutedText}"/>
                                        <TextBlock Text="SELECTED APPS" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource MutedText}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="OverviewAppsValue" Text="0 selected"
                                               FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock Text="Use Applications to change" Style="{StaticResource SectionDescription}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="0">
                                <StackPanel Spacing="9">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Save" Foreground="{ThemeResource MutedText}"/>
                                        <TextBlock Text="BACKUP SESSION" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource MutedText}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="OverviewBackupValue" Text="Not started"
                                               FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Current application session" Style="{StaticResource SectionDescription}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Device connection" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="Enable USB debugging and authorize this PC on your Android device."
                                                   Style="{StaticResource SectionDescription}"/>
                                    </StackPanel>
                                    <SymbolIcon Grid.Column="1" Symbol="CellPhone" Foreground="{ThemeResource MutedText}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ComboBox x:Name="DeviceCombo" MinWidth="205" MaxWidth="390"
                                              SelectionChanged="DeviceSelection_Changed"
                                              PlaceholderText="No authorized devices"/>
                                    <Button Content="Refresh" Click="Refresh_Click"/>
                                    <Button Content="Check root" Click="Inspect_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="DeviceInfo" Text="Not connected"
                                           Style="{StaticResource SectionDescription}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Backup destination" Style="{StaticResource SectionHeading}"/>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DestinationBox" PlaceholderText="Choose a local backup folder"/>
                                    <Button Grid.Column="1" Content="Browse folder" Click="Destination_Click"/>
                                </Grid>
                                <CheckBox x:Name="StopAppsCheck"
                                          Content="Force-stop selected apps for a more consistent backup"/>
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                                         Title="Local backups are not encrypted"
                                         Message="Keep your private app-data archives on a trusted drive."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Activity" Style="{StaticResource SectionHeading}"/>
                                    <TextBlock Grid.Column="1" Text="This session" FontSize="12"
                                               Foreground="{ThemeResource MutedText}" VerticalAlignment="Center"/>
                                </Grid>
                                <ListView x:Name="ActivityList" Height="210" SelectionMode="None"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ApplicationsPage" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Visible"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel MaxWidth="920" Spacing="12">
                        <TextBlock Text="Applications" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Choose apps and the backup components to include. Root is required for private app data."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Select all" Click="SelectAllApps_Click"/>
                                    <Button Content="Clear" Click="ClearApps_Click"/>
                                    <TextBlock x:Name="AppCount" Text="Inspect a device to load apps"
                                               VerticalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>
                                <TextBox x:Name="AppSearchBox" PlaceholderText="Search package name"
                                         TextChanged="AppSearch_TextChanged"/>
                                <ListView x:Name="ApplicationChoices" Height="300" SelectionMode="Multiple"
                                          SelectionChanged="Applications_SelectionChanged"/>
                                <TextBlock Text="Selected apps are preserved when filtering this list."
                                           FontSize="12" Opacity="0.72" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="App data backup" FontSize="21" FontWeight="SemiBold"/>
                                        <TextBlock Text="Keep the app and its data together, per package." Opacity="0.72"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#234F48" CornerRadius="9" Padding="12,6"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="ROOT MODE" Foreground="#AFF0DE" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Backup profile" FontSize="13" Opacity="0.72"/>
                                <ComboBox x:Name="BackupPreset" SelectionChanged="BackupPreset_Changed"
                                          SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Complete app backup: APK + internal data + external files"/>
                                    <ComboBoxItem Content="App and private data only"/>
                                    <ComboBoxItem Content="APK only"/>
                                </ComboBox>
                                <TextBlock Text="Per-app output: apps / package.name / apk, credential_encrypted.tar, device_encrypted.tar, external_data.tar, obb.tar and media.tar (when present)."
                                           FontSize="12" Opacity="0.74" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Advanced backup components" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Choose what to capture for each selected app."
                                           Opacity="0.7" TextWrapping="Wrap"/>
                                <CheckBox x:Name="ApkCheck" Content="APK + split APKs" IsChecked="True"/>
                                <CheckBox x:Name="PrivateDataCheck" Content="Private app data (CE / DE)" IsChecked="True"/>
                                <CheckBox x:Name="AppExternalCheck" Content="External app data (Android/data)" IsChecked="True"/>
                                <CheckBox x:Name="AppObbCheck" Content="Expansion files (OBB)" IsChecked="True"/>
                                <CheckBox x:Name="AppMediaCheck" Content="Per-app media (Android/media)" IsChecked="True"/>
                                <TextBlock Text="Some encrypted files and hardware-bound account secrets cannot be migrated."
                                           FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="StoragePage" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Visible"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel MaxWidth="920" Spacing="14">
                        <TextBlock Text="Photos &amp; files" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Select shared-storage categories to include in this backup."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Shared storage" FontSize="19" FontWeight="SemiBold"/>
                                <CheckBox x:Name="DcimCheck" Content="Camera  /  DCIM" IsChecked="True"/>
                                <CheckBox x:Name="PicturesCheck" Content="Pictures" IsChecked="True"/>
                                <CheckBox x:Name="MoviesCheck" Content="Videos  /  Movies" IsChecked="True"/>
                                <CheckBox x:Name="DownloadsCheck" Content="Downloads" IsChecked="True"/>
                                <CheckBox x:Name="DocumentsCheck" Content="Documents" IsChecked="True"/>
                                <CheckBox x:Name="MusicCheck" Content="Music"/>
                                <CheckBox x:Name="ExternalDataCheck" Content="Android/data"/>
                                <CheckBox x:Name="ExternalMediaCheck" Content="Android/media"/>
                                <CheckBox x:Name="ObbCheck" Content="Android/obb"/>
                            </StackPanel>
                        </Border>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="Temp root is required"
                                 Message="Some encrypted content and hardware-bound Android Keystore data cannot be restored on other devices."/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="RestorePage" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Visible"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel Spacing="14" MaxWidth="920" HorizontalAlignment="Stretch">
                        <TextBlock Text="Restore app data" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Recover an installed app's local data from a verified Android Backup archive."
                                   Opacity="0.74" TextWrapping="Wrap"/>
                        <Border Background="#1E5148" CornerRadius="14" Padding="20" Margin="0,2,0,8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Recover with a safety snapshot" FontSize="18"
                                               Foreground="#C4F4E9" FontWeight="SemiBold"/>
                                    <TextBlock Text="First verify hashes and device compatibility. Before restoring, make another backup of the current app."
                                               TextWrapping="Wrap" Foreground="#E0F0EB"/>
                                </StackPanel>
                                <SymbolIcon Grid.Column="1" Symbol="Refresh" Foreground="#B7EFDE"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="01  Select an existing backup" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Choose the folder containing manifest.json and apps."
                                           TextWrapping="Wrap" Opacity="0.72"/>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RestoreFolderBox" PlaceholderText="Select a backup folder"
                                             IsReadOnly="True" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse backup" Click="RestoreBrowse_Click"/>
                                </Grid>
                                <Button Content="Check backup and compatibility" Click="RestorePlan_Click"
                                        HorizontalAlignment="Left"/>
                                <TextBlock x:Name="RestorePreviewText" Text="No backup selected."
                                           TextWrapping="Wrap" Opacity="0.8"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="02  Choose the application" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Restore only app data belonging to a selected installed package."
                                           TextWrapping="Wrap" Opacity="0.72"/>
                                <ComboBox x:Name="RestorePackageCombo" PlaceholderText="Select an application to recover"
                                          HorizontalAlignment="Stretch" SelectionChanged="RestorePackage_Changed"/>
                                <Button Content="Check app compatibility" Click="RestorePreflight_Click"
                                        HorizontalAlignment="Left"/>
                                <TextBlock x:Name="RestorePreflightText" Text="Select an app and run the compatibility check. No device files are changed."
                                           TextWrapping="Wrap" Opacity="0.8"/>
                                <TextBlock Text="Pre-restore safety backups are saved in Documents/AndroidBackups/restore-safety."
                                           TextWrapping="Wrap" Opacity="0.72" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="03  Restore safely" FontSize="18" FontWeight="SemiBold"/>
                                <InfoBar Severity="Warning" IsOpen="True" IsClosable="False"
                                         Title="Restoring can replace existing app data"
                                         Message="Requires the original device, Android version, user 0, and an installed APK build whose SHA-256 matches the backup. This preview never silently reinstalls apps."/>
                                <Button x:Name="RestoreExecuteButton" Content="Restore selected app data"
                                        Click="RestoreExecute_Click" IsEnabled="False"
                                        HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"/>
                                <TextBlock x:Name="RestoreResultText"
                                           Text="Validate a backup before enabling the restore button."
                                           Opacity="0.8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SecurityPage" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Visible"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel MaxWidth="920" Spacing="14">
                        <TextBlock Text="Ransomware scan" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Read-only investigation of suspicious filenames in Android shared storage."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Scan connected Android" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Requires an active root shell. Checks selected shared folders for ransom-note filenames and unusual encrypted-file extensions."
                                           Opacity="0.7" TextWrapping="Wrap"/>
                                <Button Content="Scan for indicators" Click="Scan_Click" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="SecuritySummary" Text="No scan performed yet." TextWrapping="Wrap"/>
                                <TextBlock x:Name="SecurityStatistics" Text=""/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Review findings" FontSize="19" FontWeight="SemiBold"/>
                                <ListView x:Name="SecurityFindings" Height="280" SelectionMode="None"/>
                            </StackPanel>
                        </Border>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="Heuristic scan, not antivirus"
                                 Message="A match does not confirm ransomware, and no matches do not prove safety. The scan does not delete, quarantine or upload files."/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SetupPage" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Visible"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel MaxWidth="920" Spacing="12">
                        <TextBlock Text="Setup &amp; drivers" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Set up ADB, Android USB drivers, and optional Windows components."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Android Platform Tools" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Install ADB from Google's official ZIP into the local application folder."
                                           Opacity="0.7" TextWrapping="Wrap"/>
                                <TextBox x:Name="AdbPathBox" Text="adb" Header="ADB executable path"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Download &amp; install ADB" Click="InstallAdb_Click"/>
                                    <Button Content="Open official download page" Click="OpenGoogle_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Windows USB driver" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Manage Android USB connectivity and drivers."
                                           Opacity="0.7" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Find OEM driver" Click="OpenOem_Click"/>
                                    <Button Content="Install driver INF" Click="InstallInf_Click"/>
                                    <Button Content="Scan devices" Click="ScanDevices_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Microsoft Visual C++ runtime" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Optional compatibility dependency. WinUI runtime is bundled with this application."
                                           Opacity="0.7" TextWrapping="Wrap"/>
                                <Button Content="Open Microsoft VC++ installer" HorizontalAlignment="Left"
                                        Click="OpenVc_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <Grid Grid.Row="2" Background="{ThemeResource Surface}" Padding="18,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Content="Backup selected apps &amp; files" Click="Backup_Click" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel_Click"
                    IsEnabled="False"/>
            <Button Grid.Column="2" Content="Verify backup" Click="Verify_Click"/>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                <ProgressBar x:Name="WorkProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="FooterText" Text="Connect a device to begin"
                           Opacity="0.7" TextAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
